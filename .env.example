# TraceLens 환경 변수 템플릿
# 이 파일을 .env 로 복사한 뒤 값을 채워서 사용합니다.
# 실제 값은 .env 에만 작성하고, 이 파일에는 절대 실제 값을 넣지 않습니다.

# ===== MongoDB (API Transaction, Read-only) =====
MONGO_URI=
MONGO_DATABASE=

# ===== MySQL (eKYC SaaS Transaction, Read-only) =====
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ===== LLM =====
# OpenAI API 키 (https://platform.openai.com/)
OPENAI_API_KEY=

# ===== LangSmith (모니터링 / 디버깅) =====
# 주의: tracing 을 켜면 Graph State(DB 조회 결과, eKYC 개인정보 포함)가
# LangSmith 클라우드로 전송됩니다. 기본은 꺼두고, 켤 경우 마스킹 후 사용합니다.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=
LANGSMITH_API_KEY=

# ===== Query Guardrail =====
# DB 쿼리 timeout (ms)
DB_QUERY_TIMEOUT_MS=10000
# 기본 / 최대 조회 건수
DEFAULT_RESULT_LIMIT=50
MAX_RESULT_LIMIT=500
# 최대 조회 기간 (일)
MAX_QUERY_PERIOD_DAYS=31

# ===== 기타 =====
# 날짜 해석 기준 타임존 ("어제", "지난주" 계산용)
APP_TIMEZONE=Asia/Seoul
